# Server-only model credentials. Never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6.1-sol
OPENAI_AXIS_MODEL=gpt-6-astra
OPENAI_BRIEF_MODEL=gpt-6-luna
OPENAI_RELATIONSHIP_MODEL=gpt-6-astra
COPILOTKIT_TELEMETRY_DISABLED=true

# Optional Cognee Cloud relationship search. All credentials stay server-side.
# Sync the public archive with: node scripts/sync-cognee.mjs (from repo root).
COGNEE_API_KEY=
COGNEE_API_URL=
COGNEE_DATASET=afterlife
# Optional UUID for a dataset shared with this API user.
COGNEE_DATASET_ID=
COGNEE_TIMEOUT_MS=12000

# Optional Supabase project reads and GitHub ownership verification.
# Leave empty to use ../data/projects.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional verified Zero draft adapter. No message is sent automatically.
ZERO_DRAFT_ENDPOINT=
ZERO_API_KEY=

# Explicitly permit unverified workspace preferences in a loopback production
# server. Keep unset on any public deployment.
AFTERLIFE_LOCAL_MODE=

# Optional public base URL for canonical, Open Graph, and social image metadata.
# Example: https://afterlife.example.com
NEXT_PUBLIC_SITE_URL=
